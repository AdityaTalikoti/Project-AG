# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback

# MongoDB Connection
MONGODB_URI=your_mongodb_connection_string_here

# Frontend URL (exact origin, no trailing slash)
FRONTEND_URL=http://localhost:5174

# Node Environment
NODE_ENV=development

# Gemini API Key (for AI features)
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudinary Configuration (for file uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# SMTP Email Configuration (REQUIRED in production for password-reset OTP delivery)
# Without these, password-reset emails will fail silently in production.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
EMAIL_FROM="ScholarSync Security" <no-reply@yourdomain.com>

# Optional: HMAC salt for OTP hashing. A random secret adds extra security.
# SESSION_SECRET=your-random-64-char-secret-here

# Optional: Restrict to additional allowed origins (comma-separated exact origins)
# ALLOWED_ORIGINS=https://your-preview-deploy.vercel.app

# Optional: Cookie domain for cross-subdomain session sharing in production
# COOKIE_DOMAIN=yourdomain.com
